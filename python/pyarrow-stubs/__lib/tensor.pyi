from typing import ClassVar
from typing_extensions import CapsuleType

from collections.abc import Iterable, Sequence
import numpy as np

from pyarrow.lib import _Weakrefable
from .types import DataType
from scipy.sparse import (
    coo_array,
    coo_matrix,
    csc_array,
    csc_matrix,
    csr_array,
    csr_matrix,
)
from sparse import COO

class Tensor(_Weakrefable):
    @staticmethod
    def from_numpy(
        obj: np.ndarray, dim_names: Iterable[str] | None = None
    ) -> Tensor: ...
    def to_numpy(self) -> np.ndarray: ...
    def equals(self, other: Tensor) -> bool: ...
    def dim_name(self, i: int) -> str: ...
    @property
    def dim_names(self) -> list[str]: ...
    @property
    def is_mutable(self) -> bool: ...
    @property
    def is_contiguous(self) -> bool: ...
    @property
    def ndim(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def strides(self) -> tuple[int, ...]: ...
    @staticmethod
    def from_dlpack(
        x: object,
        /,
        *,
        device: tuple[int, int] | None = None,
        copy: bool | None = None,
    ) -> Tensor: ...
    def __dlpack__(
        self,
        *,
        stream: int | None = None,
        max_version: tuple[int, int] | None = None,
        dl_device: tuple[int, int] | None = None,
        copy: bool | None = None,
    ) -> CapsuleType: ...
    def __dlpack_device__(self) -> tuple[int, int]: ...
    @property
    def type(self) -> DataType: ...
    __hash__: ClassVar[None]  # type: ignore[assignment]

class SparseCOOTensor(_Weakrefable):
    @classmethod
    def from_dense_numpy(
        cls, obj: np.ndarray, dim_names: Iterable[str] | None = None
    ) -> SparseCOOTensor: ...
    @staticmethod
    def from_numpy(
        data: np.ndarray,
        coords: np.ndarray,
        shape: Iterable[int],
        dim_names: Iterable[str] | None = None,
    ) -> SparseCOOTensor: ...
    @staticmethod
    def from_scipy(
        obj: coo_array | coo_matrix, dim_names: Iterable[str] | None = None
    ) -> SparseCOOTensor: ...
    @staticmethod
    def from_pydata_sparse(
        obj: COO, dim_names: Iterable[str] | None = None
    ) -> SparseCOOTensor: ...
    @staticmethod
    def from_tensor(obj: Tensor) -> SparseCOOTensor: ...
    def to_numpy(self) -> tuple[np.ndarray, np.ndarray]: ...
    def to_scipy(self) -> coo_array: ...
    def to_pydata_sparse(self) -> COO: ...
    def to_tensor(self) -> Tensor: ...
    def equals(self, other: SparseCOOTensor) -> bool: ...
    @property
    def is_mutable(self) -> bool: ...
    @property
    def ndim(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    def dim_name(self, i: int) -> str: ...
    @property
    def dim_names(self) -> tuple[str, ...]: ...
    @property
    def non_zero_length(self) -> int: ...
    @property
    def has_canonical_format(self) -> bool: ...
    @property
    def type(self) -> DataType: ...
    __hash__: ClassVar[None]  # type: ignore[assignment]

