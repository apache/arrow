+// MSVC compatibility: __builtin_ctz/__builtin_ctzll are GCC/Clang builtins.
+// Provide equivalents using MSVC intrinsics (_BitScanForward).
+#if defined(_MSC_VER)
+  #include <intrin.h>
+  static inline unsigned long _simdjson_ctz(unsigned long value) {
+    unsigned long result;
+    _BitScanForward(&result, value);
+    return result;
+  }
+  static inline unsigned long _simdjson_ctzll(uint64_t value) {
+    unsigned long result;
+    _BitScanForward64(&result, value);
+    return result;
+  }
+  #define __builtin_ctz(x)   _simdjson_ctz(x)
+  #define __builtin_ctzll(x) _simdjson_ctzll(x)
+#endif
