# https://github.com/boostorg/locale/pull/273

From f51b58cd34a2a0e3a1ce974287ec0ede0fc9d1fe Mon Sep 17 00:00:00 2001
From: aouxwoux <81102668+aouxwoux@users.noreply.github.com>
Date: Sun, 25 Oct 2026 17:42:54 +0000
Subject: [PATCH] cmake: use remove_item for locale.hpp

diff --git a/libs/locale/CMakeLists.txt b/libs/locale/CMakeLists.txt
index c0b4e6932a..efae306234 100644
--- a/libs/locale/CMakeLists.txt
+++ b/libs/locale/CMakeLists.txt
@@ -232,9 +232,10 @@
 list(FILTER sources_src INCLUDE REGEX "^src/")
 set(sources_inc ${sources})
 list(FILTER sources_inc EXCLUDE REGEX "^src/")
+list(REMOVE_ITEM sources_inc "${CMAKE_CURRENT_SOURCE_DIR}/include/boost/locale.hpp")
+source_group("headers" FILES "include/boost/locale.hpp")
 source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}/src" PREFIX "sources" FILES ${sources_src})
 source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}/include/boost/locale" PREFIX "headers" FILES ${sources_inc})
-source_group("headers" FILES "include/boost/locale.hpp")
 
 message(STATUS "Boost.Locale: "
   "iconv ${BOOST_LOCALE_ENABLE_ICONV}, "
