#
# This config sets the following variables in your project::
#
#   ArrowAzure_FOUND - true if Arrow Azure found on the system
#
# This config sets the following targets in your project::
#
#   ArrowAzure::arrow_azure_shared - for linked as shared library if shared library is built
#   ArrowAzure::arrow_azure_static - for linked as static library if static library is built

@PACKAGE_INIT@

set(ARROW_AZURE_SYSTEM_DEPENDENCIES "@ARROW_AZURE_SYSTEM_DEPENDENCIES@")
set(ARROW_AZURE_BUNDLED_STATIC_LIBS "@ARROW_AZURE_BUNDLED_STATIC_LIBS@")

include(CMakeFindDependencyMacro)
find_dependency(Arrow CONFIG)

if(ARROW_BUILD_STATIC)
  arrow_find_dependencies("${ARROW_AZURE_SYSTEM_DEPENDENCIES}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ArrowAzureTargets.cmake")

if(TARGET ArrowAzure::arrow_azure_static
   AND ARROW_AZURE_BUNDLED_STATIC_LIBS
   AND NOT TARGET ArrowAzure::arrow_azure_bundled_dependencies)
  add_library(ArrowAzure::arrow_azure_bundled_dependencies STATIC IMPORTED)
  get_target_property(arrow_azure_bundled_dependencies_link_libs
                      ArrowAzure::arrow_azure_static INTERFACE_LINK_LIBRARIES)
  list(REMOVE_ITEM arrow_azure_bundled_dependencies_link_libs
       ArrowAzure::arrow_azure_bundled_dependencies Arrow::arrow_static)
  if(NOT WIN32)
    list(APPEND arrow_azure_bundled_dependencies_link_libs OpenSSL::SSL OpenSSL::Crypto)
  endif()
  target_link_libraries(ArrowAzure::arrow_azure_bundled_dependencies
                        INTERFACE ${arrow_azure_bundled_dependencies_link_libs})
  get_target_property(arrow_azure_static_configurations ArrowAzure::arrow_azure_static
                      IMPORTED_CONFIGURATIONS)
  foreach(CONFIGURATION ${arrow_azure_static_configurations})
    string(TOUPPER "${CONFIGURATION}" CONFIGURATION)
    get_target_property(arrow_azure_static_location ArrowAzure::arrow_azure_static
                        IMPORTED_LOCATION_${CONFIGURATION})
    get_filename_component(arrow_azure_lib_dir "${arrow_azure_static_location}"
                           DIRECTORY)
    set_property(TARGET ArrowAzure::arrow_azure_bundled_dependencies
                 APPEND
                 PROPERTY IMPORTED_CONFIGURATIONS ${CONFIGURATION})
    set_target_properties(ArrowAzure::arrow_azure_bundled_dependencies
                          PROPERTIES IMPORTED_LOCATION_${CONFIGURATION}
                                     "${arrow_azure_lib_dir}/${CMAKE_STATIC_LIBRARY_PREFIX}arrow_azure_bundled_dependencies${CMAKE_STATIC_LIBRARY_SUFFIX}"
    )
  endforeach()
endif()

arrow_keep_backward_compatibility(ArrowAzure arrow_azure)

check_required_components(ArrowAzure)

arrow_show_details(ArrowAzure ARROW_AZURE)
